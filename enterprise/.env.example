# Plantilla; configurar estos valores en el servidor, sin publicarlos en Git.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=centromando_ims
MYSQL_USER=ims_migracion
MYSQL_PASSWORD=
# API candidata: mantener deshabilitada hasta preparar su esquema y usuarios.
# Para API usar un archivo privado y usuario propio de aplicación; no reutilizar
# credenciales de migración ni de otras aplicaciones empresariales.
IMS_API_HABILITADA=0

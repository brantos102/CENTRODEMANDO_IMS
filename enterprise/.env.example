# Plantilla; configurar estos valores en el servidor, sin publicarlos en Git.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=centromando_ims
MYSQL_USER=ims_migracion
MYSQL_PASSWORD=
# Traslado histórico: habilitar solo para el ensayo en una base exclusiva.
IMS_MIGRACION_OPERATIVA=0
# API candidata: mantener deshabilitada hasta preparar su esquema y usuarios.
# Para API usar un archivo privado y usuario propio de aplicación; no reutilizar
# credenciales de migración ni de otras aplicaciones empresariales.
IMS_API_HABILITADA=0
# Piloto: 1 bloquea captura HTTP y muestra el aviso de consulta en la interfaz.
# Usar además permisos ACL de lectura y una cuenta MySQL sin escritura operativa.
IMS_SOLO_LECTURA=0
IMS_HOST=127.0.0.1
IMS_PORT=3003
IMS_PUBLIC_URL=https://apps.flexnetuio.com:8445
